{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Ovo postaje crkve-domovina.<subdomena>.workers.dev; produkcijska domena
  // crkve.domovina.ai kači se ručno u Cloudflare dashboardu (Workers → Domains).
  "name": "crkve-domovina",

  // Račun D.O.M. — isti kao gis-domovina i klubovi-domovina. Eksplicitno jer
  // je ovaj OAuth token vezan na više računa, pa bi wrangler inače tražio
  // izbor i pao u neinteraktivnom pokretanju (deploy.sh, CI).
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // NAMJERNO nema "main" ni "assets": Nitro ih generira sam u
  // .output/server/wrangler.json i tamošnje vrijednosti pobjeđuju.
  // Sve ostalo odavde (name, compat, flags, vars, bindings) se preuzima.
  //
  // `wrangler deploy` iz roota radi jer build zapiše .wrangler/deploy/config.json
  // koji preusmjerava wrangler na generirani config.
  //
  // Ovaj Worker NEMA nijedan secret ni binding: katalog je statički JSON u
  // assetima (public/data/, ~9400 datoteka), a nijedan izvor ne traži ključ.
}
