# `make all` radi BEZ IKAKVIH KLJUČEVA — svi osnovni izvori su javni i
# besplatni (data.gov.hr CKAN, OSM Overpass, Wikidata SPARQL, Nominatim).
#
# Ključ treba SAMO za `make places` (scripts/13): precizne koordinate župa
# koje nemaju matchiranu crkvu + nezavisna provjera matchera.

# Google Places API (New). Projekt mora imati uključen "Places API (New)".
# Dvije zamke:
#   - default dnevna kvota SearchTextRequestPerDayPerProject = 100 → digni je
#     u GCP konzoli (APIs & Services → Quotas);
#   - ključ s IP restrikcijom vraća 403 API_KEY_IP_ADDRESS_BLOCKED čim se
#     promijeni javni IP → dodaj IP ili koristi ključ bez restrikcije.
# GOOGLE_MAPS_API_KEY=AIza...

# Lokalni Nominatim (Docker) — bez 1 req/s throttlea. Vidi README.
# NOMINATIM_ENDPOINT=http://localhost:8080

# Kontakt u User-Agent headeru prema javnim API-jima (OSM/Wikidata pravila
# lijepog ponašanja traže identifikaciju). Default je repo URL.
# CONTACT_EMAIL=stepanic.matija@gmail.com

# Alternativni Overpass endpoint ako je javni preopterećen.
# OVERPASS_ENDPOINT=https://overpass.kumi.systems/api/interpreter
