# Cijeli pipeline radi BEZ IKAKVIH KLJUČEVA — svi izvori su javni i besplatni
# (data.gov.hr CKAN, OSM Overpass, Wikidata SPARQL, Nominatim).
# Ovaj file postoji samo za opcionalne performanse/limite.

# Lokalni Nominatim (Docker) — bez 1 req/s throttlea. Vidi README.
# NOMINATIM_ENDPOINT=http://localhost:8080

# Kontakt u User-Agent headeru prema javnim API-jima (OSM/Wikidata pravila
# lijepog ponašanja traže identifikaciju). Default je repo URL.
# CONTACT_EMAIL=stepanic.matija@gmail.com

# Alternativni Overpass endpoint ako je javni preopterećen.
# OVERPASS_ENDPOINT=https://overpass.kumi.systems/api/interpreter
